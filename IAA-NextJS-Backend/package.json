{
  "name": "iaa-nextjs-backend",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/embedded/*.test.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:stage": "node --import tsx scripts/stage-information-layer.ts",
    "db:provision-user": "node --import tsx scripts/provision-user.ts",
    "db:check": "node --import tsx scripts/check-database.ts",
    "db:seed:dev": "node --import tsx scripts/seed-development.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:embedded": "node --import tsx --test tests/embedded/*.test.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\" \"tests/**/*.ts\"",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:production",
    "test:production": "node scripts/smoke-production.mjs"
  },
  "dependencies": {
    "dotenv": "^17.0.0",
    "exceljs": "^4.4.0",
    "jose": "^6.2.15",
    "next": "16.4.4",
    "pg": "^8.16.0",
    "pino": "^10.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-postgis": "^0.2.15",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
